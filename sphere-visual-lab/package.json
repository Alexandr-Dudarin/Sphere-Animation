{
  "name": "sphere-visual-lab",
  "version": "0.1.0",
  "description": "Reusable animated WebGL visuals for React, Three.js, and React Three Fiber.",
  "keywords": [
    "react",
    "three",
    "threejs",
    "react-three-fiber",
    "webgl",
    "3d",
    "3d-animation",
    "animated-background",
    "visual-effects",
    "sphere",
    "orbital",
    "react-component"
  ],
  "author": "Alexandr Dudarin",
  "license": "MIT",
  "homepage": "https://sphere-visual-lab.vercel.app/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexandr-Dudarin/Sphere-Animation.git",
    "directory": "sphere-visual-lab"
  },
  "bugs": {
    "url": "https://github.com/Alexandr-Dudarin/Sphere-Animation/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.lib.json && node scripts/verify-library-output.mjs",
    "build:all": "npm run build && npm run build:lib",
    "check:all": "npm test && npm run build && npm run build:lib",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "test:e2e:debug": "npm run build && playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "consumer:smoke": "node ./scripts/run-consumer-smoke.mjs",
    "pack:dry-run": "npm pack --dry-run",
    "prepack": "npm run build:lib"
  },
  "files": [
    "dist-lib"
  ],
  "main": "./dist-lib/index.js",
  "module": "./dist-lib/index.js",
  "types": "./dist-lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist-lib/types/index.d.ts",
      "import": "./dist-lib/index.js",
      "default": "./dist-lib/index.js"
    },
    "./style.css": "./dist-lib/style.css"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.184.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "three": "^0.184.0",
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.9",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  }
}
